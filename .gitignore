.ipynb_checkpoints/
*.ipynb.bak


# ---------------------------------------------------------------- #
#  IDE / editors                                                    #
# ---------------------------------------------------------------- #

.vscode/
.idea/
*.iml
*.swp
*.swo
*~
*.orig
*.rej
.tags
.tags.lock


# ---------------------------------------------------------------- #
#  Operating system cruft                                           #
# ---------------------------------------------------------------- #

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ---------------------------------------------------------------- #
#  Project-specific                                                 #
# ---------------------------------------------------------------- #

# Emitted by the editor's Ctrl+G.  Regenerate from the graph
# itself; never merge conflicts worth keeping.
/generated.py

# Auto Save buffer written by Settings -> Auto Save when no
# document is currently open.
/autosave.json

# Local override of the persistent settings.  The canonical file
# lives at ~/.pytorchui/settings.json and is not part of the
# repository.
/settings.json
/.pytorchui/

# Backups written by the various patch scripts (edit.py,
# fix_*.py, ...).  They exist to be deleted once a patch is
# verified.
*.bak_*
*.bak

# Local PyTorch / HF caches if you experiment with models inside
# the project directory.  Normally these live under
# ~/.cache/ or ~/.pytorchui/.
/.cache/
/.torch/
/.huggingface/

# ---------------------------------------------------------------- #
#  Cleanup rules                                                    #
# ---------------------------------------------------------------- #

data/
.pytorchui/
autosave.json
main.db
generated.py
*.bak_*
**/__pycache__/
*.pyc
