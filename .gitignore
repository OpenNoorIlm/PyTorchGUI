# ---------------------------------------------------------------- #

*.qm
*.qmlc
*.jsc
moc_*.py
qrc_*.py
ui_*.py
*.ui.pyc


# ---------------------------------------------------------------- #
#  Jupyter (in case you sketch ideas in a notebook)                 #
