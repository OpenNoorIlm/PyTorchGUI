# ---------------------------------------------------------------- #
#  Python                                                           #
# ---------------------------------------------------------------- #

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt


# ---------------------------------------------------------------- #
#  Virtual environments                                             #
# ---------------------------------------------------------------- #

.venv/
venv/
ENV/
env/
.python-version


